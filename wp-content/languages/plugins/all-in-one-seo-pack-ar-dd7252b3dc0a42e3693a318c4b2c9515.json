8\u0644\u064a\u062f \u0646\u0642\u0627\u0637 \u0631\u0626\u064a\u0633\u064a\u0629"],"Generate FAQs":["\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0645\u062a\u0643\u0631\u0631\u0651\u0629"],"Generate helpful FAQs based on your content to enhance user engagement and boost SEO.":["\u062a\u0648\u0644\u064a\u062f \u0623\u0633\u0626\u0644\u0629 \u0648\u0623\u062c\u0648\u0628\u0629 \u0645\u062a\u0643\u0631\u0631\u0651\u0629 \u0645\u0641\u064a\u062f\u0629 \u0627\u0633\u062a\u0646\u0627\u062f\u064b\u0627 \u0625\u0644\u0649 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u062e\u0627\u0635 \u0628\u0643 \u0644\u062a\u0639\u0632\u064a\u0632 \u062a\u0641\u0627\u0639\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u062a\u0639\u0632\u064a\u0632 \u062a.\u0645.\u0628."],"Generate FAQs (%1$d credits)":["\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0645\u062a\u0643\u0631\u0631\u0651\u0629 (%1$d \u0623\u0631\u0635\u062f\u0629)"],"Insert Key Points Block":["\u0625\u062f\u0631\u0627\u062c \u0627\u0644\u0646\u0642\u0627\u0637 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0628\u062f\u0648\u0646 \u0645\u0643\u0648\u0646"," \u0625\u062f\u0631\u0627\u062c \u0645\u0643\u0648\u0646 \u0648\u0627\u062d\u062f \u0627\u0644\u0646\u0642\u0627\u0637 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629"," \u0625\u062f\u0631\u0627\u062c \u0645\u0643\u0648\u0646\u064a\u0646 \u0627\u0644\u0646\u0642\u0627\u0637 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629"," \u0625\u062f\u0631\u0627\u062c \u0645\u0643\u0648\u0646\u0627\u062a \u0627\u0644\u0646\u0642\u0627\u0637 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629"," \u0625\u062f\u0631\u0627\u062c \u0645\u0643\u0648\u0646 \u0627\u0644\u0646\u0642\u0627\u0637 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629"," \u0625\u062f\u0631\u0627\u062c \u0645\u0643\u0648\u0646 \u0627\u0644\u0646\u0642\u0627\u0637 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629"